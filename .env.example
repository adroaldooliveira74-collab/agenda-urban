# Porta HTTP
PORT=3000
# URL pública do sistema (usada em links nos PDFs, e-mails e WhatsApp)
APP_URL=http://localhost:3000
# Troque por um valor longo e aleatório em produção
JWT_SECRET=troque-esta-chave
# Pasta onde ficam o banco SQLite e os arquivos enviados
DATA_DIR=./data

# ---- E-mail (SMTP). Sem SMTP_HOST, os envios ficam registrados como "simulado".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Urban Clin <nao-responda@urbanclin.com.br>"

# ---- WhatsApp (API HTTP genérica: Z-API, Evolution API, WPPConnect, etc.)
# O sistema faz POST em WHATSAPP_API_URL com JSON {phone, message, fileName?, fileBase64?}
# e cabeçalho Authorization: Bearer WHATSAPP_API_TOKEN.
# Sem WHATSAPP_API_URL, os envios ficam registrados como "simulado".
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Intervalo (minutos) da rotina de alertas automáticos
ALERTAS_INTERVALO_MIN=15
